NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase transaction pooler, port 6543, include ?pgbouncer=true
DATABASE_URL=
# Supabase direct connection, port 5432 (or session pooler for IPv4)
DIRECT_URL=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Optional current Groq vision model. Blank uses Tesseract OCR + the text model.
GROQ_VISION_MODEL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Your actual Resend receiving domain (for example, your assigned *.resend.app domain).
INBOUND_EMAIL_DOMAIN=
# Optional demo seed settings:
SEED_USER_ID=
SEED_PASSWORD=
