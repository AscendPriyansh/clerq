{
  "name": "clerq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:secure": "node scripts/secure-db.mjs",
    "test": "jest --runInBand",
    "test:ocr:built": "node --import tsx scripts/test-built-ocr.ts",
    "test:browser": "node --conditions=react-server --import tsx scripts/test-browser.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "storage:setup": "node scripts/setup-storage.mjs",
    "jobs:retry": "node --conditions=react-server --import tsx scripts/retry-email-jobs.ts",
    "test:integration": "node --conditions=react-server --import tsx scripts/test-workflows.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/env": "^16.3.5",
    "@prisma/client": "^6.19.3",
