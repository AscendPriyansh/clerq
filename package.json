    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jest": "^30.5.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
