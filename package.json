    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^8.21.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vercel/queue": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "groq-sdk": "^1.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "nuqs": "^2.10.1",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.2",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
